# ═══════════════════════════════════════════════════════
# Project Chimera — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!
# ═══════════════════════════════════════════════════════

# --- Groq API (for standalone LangChain pipeline) ---
GROQ_API_KEY="your-groq-api-key-here"

# --- GitLab Integration ---
GITLAB_TOKEN="your-gitlab-personal-access-token"
GITLAB_URL="https://gitlab.com"

# --- GitHub Integration (legacy, optional) ---
# GITHUB_TOKEN="your-github-token-here"
# GITHUB_USERNAME="your-github-username"

# --- Configuration ---
# DRY_RUN=true  # Set to test without creating actual MRs/issues
# CHIMERA_VENV_PREFIX="venv_chimera"  # Prefix for virtual environment names
